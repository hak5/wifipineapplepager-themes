{
  "screen_name": "launch_payload_dialog",
  "status_bar": "default",
  "windowed_canvas": true,
  "cache_canvases": true,
  "button_map": {
    "a": "select",
    "b": "back",
    "up": "previous",
    "down": "next",
    "left": "back",
    "right": "noop"
  },
  "background": {
    "layers": [
      { "image_path": "assets/settings/launch_payload_dialog/launch_window.png", "x": 18, "y": 38 },
      { "variable_name": "$_PAYLOAD_TITLE", "x": 46, "y": 61, "string_template": { "text_color_palette": "red", "text_size": "medium", "max_chars": 22, "wrap_text": false, "max_lines": 1 } },
      { "text": "Author:", "x": 46, "y": 87, "text_size": "small" },
      { "variable_name": "$_PAYLOAD_AUTHOR_NAME", "x": 111, "y": 87, "string_template": { "text_size": "small", "max_chars": 24, "wrap_text": false, "max_lines": 1 } }
    ]
  },
  "menu_items": [
    {
      "id": "Launch",
      "layers": [
        { "image_path": "assets/settings/payload_dialog_option_bg.png", "x": 44, "y": 118 },
        { "image_path": "assets/settings/flame.png", "x": 102, "y": 163 },
        { "text": "Launch", "x": 59, "y": 126, "text_color_palette": "bl_white", "text_size": "large" }
      ],
      "selected_layers": [
        { "image_path": "assets/settings/payload_dialog_option_bg.png", "x": 44, "y": 118 },
        { "image_path": "assets/settings/flame.png", "x": 102, "y": 163, "recolor_palette": "green" },
        { "image_path": "assets/settings/payload_dialog_selected_box.png", "x": 44, "y": 118 },
        { "text": "Launch", "x": 59, "y": 126, "text_color_palette": "green", "text_size": "large" }
      ],
      "target": "launch_payload",
      "variable": "$_INPUT",
      "animation": [
        { "image_path": "assets/launch_payload_dialog/animation/anim_frame_1.png", "x": 354, "y": 73 },
        { "image_path": "assets/settings/launch_payload_dialog/animation/anim_frame_2.png", "x": 350, "y": 69 }
      ]
    },
    {
      "id": "Cancel",
      "layers": [
        { "image_path": "assets/settings/payload_dialog_option_bg.png", "x": 186, "y": 118 },
        { "image_path": "assets/x.png", "x": 248, "y": 165 },
        { "text": "Cancel", "x": 204, "y": 126, "text_color_palette": "bl_white", "text_size": "large" }
      ],
      "selected_layers": [
        { "image_path": "assets/settings/payload_dialog_option_bg.png", "x": 186, "y": 118 },
        { "image_path": "assets/x.png", "x": 248, "y": 165, "recolor_palette": "red" },
        { "image_path": "assets/settings/payload_dialog_selected_box.png", "x": 186, "y": 118 },
        { "text": "Cancel", "x": 204, "y": 126, "text_color_palette": "red", "text_size": "large" }
      ],
      "target": "back"
    }
  ]
}