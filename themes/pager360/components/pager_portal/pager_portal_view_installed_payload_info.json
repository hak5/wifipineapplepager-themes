          "selected_layers": [
            { "image_path": "assets/portal/list/row_selected_narrow.png", "x": 4, "y": 88 },
            { "image_path": "assets/portal/list/icon_back.png", "x": 14, "y": 92, "recolor_palette": "bl_ink" },
            { "text": "Back", "x": 42, "y": 90, "text_color_palette": "bl_ink", "text_size": "medium" }
