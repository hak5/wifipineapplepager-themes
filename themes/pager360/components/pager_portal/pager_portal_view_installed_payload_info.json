            { "x": 300, "y": 61, "variable_name": "$_PAYLOAD_AUTHOR_NAME", "string_template": { "text_size": "small", "text_color_palette": "bl_ink", "max_chars": 18, "wrap_text": false, "max_lines": 1 } },
            { "x": 300, "y": 74, "variable_name": "$_PAYLOAD_VERSION", "string_template": { "text_size": "small", "text_color_palette": "bl_ink", "max_chars": 18, "wrap_text": false, "max_lines": 1 } },
            { "x": 300, "y": 87, "variable_name": "$_PAYLOAD_UPDATED_AT", "string_template": { "text_size": "small", "text_color_palette": "bl_ink", "max_chars": 18, "wrap_text": false, "max_lines": 1 } },
            { "x": 300, "y": 100, "variable_name": "$_PAYLOAD_CATEGORY", "string_template": { "text_size": "small", "text_color_palette": "bl_ink", "max_chars": 18, "wrap_text": false, "max_lines": 1 } },
            { "x": 12, "y": 124, "variable_name": "$_PAYLOAD_DESCRIPTION", "string_template": { "max_chars": 50, "wrap_text": true, "max_lines": 5, "text_size": "small", "text_color_palette": "bl_white", "center_text_within": { "draw_bounds": false, "start_x": 12, "end_x": 468, "start_y": 124, "end_y": 189 } } }
          ]
        },
        {
          "id": "uninstall",
          "x": 0,
          "y": 0,
          "layers": [
            { "image_path": "assets/portal/list/icon_trash.png", "x": 14, "y": 62, "recolor_palette": "bl_white" },
            { "text": "Uninstall", "x": 42, "y": 60, "text_color_palette": "bl_white", "text_size": "medium" }
          ],
          "selected_layers": [
            { "image_path": "assets/portal/list/row_selected_narrow.png", "x": 4, "y": 58 },
            { "image_path": "assets/portal/list/icon_trash.png", "x": 14, "y": 62, "recolor_palette": "bl_ink" },
            { "text": "Uninstall", "x": 42, "y": 60, "text_color_palette": "bl_ink", "text_size": "medium" }
          ],
          "target": "function_uninstall_payload",
