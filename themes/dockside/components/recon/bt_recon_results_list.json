{
  "template": {
    "screen_name": "bt_recon_results_list",
    "status_bar": "bt_recon",
    "refresh_interval": 1,
    "windowed_canvas": false,
    "cache_canvases": false,
    "query_sort": "active",
    "query_ascending": false,
    "button_map": {
      "a": "select",
      "b": "back",
      "up": "previous",
      "down": "next",
      "left": "previous_page",
      "right": "next_page"
    },
