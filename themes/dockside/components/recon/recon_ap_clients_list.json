{
  "template": {
    "screen_name": "recon_selected_ap_clients_list",
    "status_bar": "recon",
    "refresh_interval": 1,
    "windowed_canvas": false,
    "cache_canvases": false,
    "query_sort": "time",
    "query_sort_by_time": true,
    "query_ascending": false,
    "button_map": {
      "a": "select",
      "b": "back",
      "up": "previous",
      "down": "next",
      "left": "previous_page",
      "right": "next_page"
    },
    "background": {
      "layers": [
        { "image_path": "assets/recon/recon_list_bg.png", "x": 0, "y": 0 },
        {
          "x": 0,
          "y": 0,
          "variable_name": "$_RECON_LIST_PAGINATOR_LABEL_SHORT",
          "string_template": {
            "text_size": "small",
            "text_color_palette": "blue",
            "center_text_within": {
              "draw_bounds": false,
              "start_x": 8,
              "end_x": 70,
              "start_y": 3,
              "end_y": 12
            }
          }
        },
        {
          "x": 0,
          "y": 12,
          "variable_name": "$_RECON_LIST_SIZE",
          "string_template": {
            "text_size": "small",
            "text_color_palette": "soft_white",
            "center_text_within": {
              "draw_bounds": false,
              "start_x": 8,
              "end_x": 72,
              "start_y": 13,
              "end_y": 28
            }
          }
        },
        { "text": "Client", "x": 40, "y": 35, "text_size": "small", "text_color_palette": "gray" },
        { "text": "dBm", "x": 238, "y": 35, "text_size": "small", "text_color_palette": "gray" },
        { "text": "MHz", "x": 278, "y": 35, "text_size": "small", "text_color_palette": "gray" },
        { "text": "Ch", "x": 322, "y": 35, "text_size": "small", "text_color_palette": "gray" },
        { "text": "Packets", "x": 360, "y": 35, "text_size": "small", "text_color_palette": "gray" },
        { "image_path": "assets/sys/scroll_track_170.png", "x": 462, "y": 50 },
        { "image_path": "assets/sys/scroll_up_off.png", "x": 464, "y": 54 },
        { "image_path": "assets/sys/scroll_thumbh_54.png", "x": 466, "y": 68 },
        { "image_path": "assets/sys/scroll_down_off.png", "x": 464, "y": 209 }
