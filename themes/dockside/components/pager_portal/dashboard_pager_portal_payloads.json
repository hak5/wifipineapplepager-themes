{
  "screen_name": "pager_portal_payloads_dashboard",
  "status_bar": "default",
  "windowed_canvas": false,
  "cache_canvases": false,
  "background": {
    "layers": [
      { "image_path": "assets/portal/base.png", "x": 0, "y": 0 },
      { "image_path": "assets/portal/sidebar_hl.png", "x": 5, "y": 74 },
      { "text": "Payloads", "text_size": "medium", "text_color_palette": "blue", "x": 146, "y": 32 },
      { "text": "Payloads", "text_size": "small", "text_color_palette": "blue", "x": 66, "y": 8 }
    ]
  },
  "pages": [
    {
      "page_index": 0,
      "menu_items": [
        {
          "id": "Get Payloads",
