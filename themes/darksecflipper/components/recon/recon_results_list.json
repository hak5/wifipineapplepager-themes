{
  "template": {
    "screen_name": "recon_results_list",
    "status_bar": "recon",
    "refresh_interval": 1,
    "windowed_canvas": false,
    "cache_canvases": false,
    "query_sort": "signal",
    "query_sort_by_time": true,
    "query_ascending": false,
    "button_map": {
      "a": "select",
      "b": "back",
      "up": "previous",
      "down": "next",
      "left": "previous_page",
      "right": "next_page"
    },
    "background": {
      "layers": [
        {
          "image_path": "assets/recon/recon_list_bg.png",
          "x": 0,
          "y": 0
        },
        {
          "x": 0,
          "y": 0,
          "variable_name": "$_RECON_LIST_PAGINATOR_LABEL_SHORT",
          "string_template": {
            "text_size": "small",
            "text_color_palette": "dark",
            "center_text_within": {
              "draw_bounds": false,
              "start_x": 8,
              "end_x": 70,
              "start_y": 3,
              "end_y": 12
            }
          }
        },
        {
          "x": 0,
          "y": 12,
          "variable_name": "$_RECON_LIST_SIZE",
          "string_template": {
            "text_size": "small",
            "text_color_palette": "dark",
            "center_text_within": {
              "draw_bounds": false,
              "start_x": 8,
              "end_x": 72,
              "start_y": 13,
              "end_y": 28
            }
          }
        }
      ]
    },
