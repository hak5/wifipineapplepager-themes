{
  "screen_name": "pager_portal_view_installed_payload_info",
  "status_bar": "min",
  "windowed_canvas": false,
  "cache_canvases": false,
  "button_map": {
    "a": "select",
    "b": "back",
    "up": "previous",
    "down": "next",
    "left": "back",
    "right": "noop"
  },
  "background": {
    "layers": [
      { "image_path": "assets/blank_recon_bg.png", "x": 0, "y": 0 },
      { "text": "Manage Payload", "x": 5, "y": 0, "text_size": "large", "text_color_palette": "blue" }
    ]
  },
  "pages": [
    {
      "page_index": 0,
      "menu_items": [
        { "id": "data",
          "unselectable":  true,
          "layers": [
            { "x": 15,   "y": 33, "variable_name": "$_PAYLOAD_TITLE", "string_template": {"text_size": "medium", "text_color_palette": "green", "max_chars": 32}},
            { "x": 19,  "y": 59, "variable_name": "$_PAYLOAD_AUTHOR_NAME", "string_template": { "text_size": "small", "text_color_palette": "yellow", "max_chars": 32}},

            { "x": 150, "y": 80, "variable_name": "$_PAYLOAD_UPDATED_AT", "string_template": { "text_size": "small", "text_color_palette": "disabled_light_gray", "center_text_within": { "draw_bounds": false, "start_x": 180, "end_x": 230, "start_y": 80, "end_y": 92 }}},
            { "x": 150, "y": 80, "variable_name": "$_PAYLOAD_VERSION", "string_template": {"text_size": "small", "text_color_palette": "disabled_light_gray", "center_text_within": { "draw_bounds": false, "start_x": 90, "end_x": 140, "start_y": 80, "end_y": 92 }}},
            { "x": 17,  "y": 80, "text": "Version:",   "text_size": "small",  "text_color_palette": "medium_gray" },
            { "x": 150, "y": 100, "variable_name": "$_PAYLOAD_CATEGORY", "string_template": { "text_size": "small", "text_color_palette": "disabled_light_gray", "center_text_within": { "draw_bounds": false, "start_x": 100, "end_x": 300, "start_y": 100, "end_y": 112 }}},
            { "x": 17,  "y": 100, "text": "Category:", "text_size": "small",  "text_color_palette": "medium_gray" },
            { "x": 150, "y": 120, "variable_name": "$_PAYLOAD_DESCRIPTION", "string_template": {"max_chars": 50, "wrap_text": true, "max_lines": 8, "text_size": "small", "text_color_palette": "disabled_light_gray", "center_text_within": { "draw_bounds": false, "start_x": 18, "end_x": 460, "start_y": 132, "end_y": 220 }}},
            { "x": 17,  "y": 120, "text": "Description:", "text_size": "small",  "text_color_palette": "medium_gray" }
          ]
        },
        {
          "id": "uninstall",
          "x":325,
          "y":61,
          "layers": [
            { "text": "Uninstall", "text_color_palette": "blue" }
          ],
          "selected_layers": [
            { "image_path": "assets/payloads_dashboard/arrow.png", "x": -25, "y": 3 },
            { "text": "Uninstall", "text_color_palette": "yellow" }
          ],
          "target": "function_uninstall_payload",
          "variable": "$_INPUT"
        },
        {
          "id": "Back",
          "x":340,
          "y":94,
          "layers": [
            { "text": "Back", "text_color_palette": "blue" }
          ],
          "selected_layers": [
            { "image_path": "assets/payloads_dashboard/arrow.png", "x": -25, "y": 3 },
            { "text": "Back", "text_color_palette": "yellow" }
          ],
          "target": "back"
        }
      ]
    }
  ]

}

