{
  "screen_name": "pager_portal_view_payload_info",
  "status_bar": "min",
  "windowed_canvas": false,
  "cache_canvases": false,
  "button_map": {
    "a": "select",
    "b": "back",
    "up": "previous",
    "down": "next",
    "left": "back",
    "right": "noop"
  },
  "background": {
    "layers": [
      { "image_path": "assets/blank_recon_bg.png", "x": 0, "y": 0 },
      { "text": "Install Payload", "x": 15, "y": 4, "text_size": "small", "text_color_palette": "white" }
    ]
  },
  "pages": [
    {
      "page_index": 0,
      "menu_items": [
        { "id": "data",
          "unselectable":  true,
          "layers": [
            { "x": 15,   "y": 25, "variable_name": "$_PAYLOAD_TITLE", "string_template": {"text_size": "medium", "text_color_palette": "black", "max_chars": 32}},
            { "x": 17,  "y": 59, "variable_name": "$_PAYLOAD_AUTHOR_NAME", "string_template": { "text_size": "small", "text_color_palette": "black", "max_chars": 32}},

            { "x": 370, "y":35, "variable_name": "$_PAYLOAD_UPDATED_AT", "string_template": { "text_size": "small", "text_color_palette": "disabled_dark_gray"}},
            { "x": 90, "y": 80, "variable_name": "$_PAYLOAD_VERSION", "string_template": {"text_size": "small", "text_color_palette": "disabled_dark_gray"}},
            { "x": 17,  "y": 80, "text": "Version:",   "text_size": "small",  "text_color_palette": "medium_gray" },
            { "x": 100, "y": 100, "variable_name": "$_PAYLOAD_CATEGORY", "string_template": { "text_size": "small", "text_color_palette": "disabled_dark_gray", "max_chars": 12, "center_text_within": { "draw_bounds": false, "start_x": 100, "end_x": 205, "start_y": 100, "end_y": 112 }}},
            { "x": 17,  "y": 100, "text": "Category:", "text_size": "small",  "text_color_palette": "medium_gray" },
            { "x": 150, "y": 120, "variable_name": "$_PAYLOAD_DESCRIPTION", "string_template": {"max_chars": 20, "wrap_text": true, "max_lines": 7, "text_size": "small", "text_color_palette": "disabled_dark_gray", "center_text_within": { "draw_bounds": false, "start_x": 6, "end_x": 205, "start_y": 132, "end_y": 220 }}},
            { "x": 17,  "y": 120, "text": "Description:", "text_size": "small",  "text_color_palette": "medium_gray" }
          ]
        },
        {
          "id": "install",
          "x":215,
          "y":62,
          "layers": [
            { "text": "Install", "text_color_palette": "black" }
          ],
          "selected_layers": [
			{ "image_path": "assets/settings/bodyhighlight.png", "x": -5, "y": -1},
            { "text": "Install", "text_color_palette": "black" }
          ],
          "target": "function_install_payload",
          "variable": "$_INPUT"
        },
        {
          "id": "Back",
          "x":215,
          "y":93,
          "layers": [
            { "text": "Back", "text_color_palette": "black" }
          ],
          "selected_layers": [
			{ "image_path": "assets/settings/bodyhighlight.png", "x": -5, "y": -1},
            { "text": "Back", "text_color_palette": "black" }
          ],
          "target": "back"
        }
      ]
    }
  ]

}

