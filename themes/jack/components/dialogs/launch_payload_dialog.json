{
  "screen_name": "launch_payload_dialog",
  "status_bar": "default",
  "windowed_canvas": true,
  "cache_canvases": true,
  "button_map": {
    "a": "select",
    "b": "back",
    "up": "previous",
    "down": "next",
    "left": "back",
    "right": "noop"
  },
  "background": {
    "layers": [
      {
        "image_path": "assets/launch_payload_dialog/launch_payload_bg.png",
        "x": 0,
        "y": 0
      },
      {
        "variable_name": "$_PAYLOAD_TITLE",
        "x": 26,
        "y": 44,
        "string_template": {
          "text_size": "medium",
          "text_color_palette": "yellow",
          "max_chars": 24,
          "wrap_text": false,
          "max_lines": 1
        }
      },
      {
        "text": "VER",
        "x": 26,
        "y": 72,
        "text_size": "small",
        "text_color_palette": "medium_gray"
      },
      {
        "variable_name": "$_PAYLOAD_VERSION",
        "x": 70,
        "y": 72,
        "string_template": {
          "text_size": "small",
          "text_color_palette": "gray",
          "max_chars": 12,
          "wrap_text": false,
          "max_lines": 1
        }
      },
      {
        "text": "BY",
        "x": 26,
        "y": 90,
        "text_size": "small",
        "text_color_palette": "medium_gray"
      },
      {
        "variable_name": "$_PAYLOAD_AUTHOR_NAME",
        "x": 70,
        "y": 90,
        "string_template": {
          "text_size": "small",
          "text_color_palette": "gray",
          "max_chars": 24,
          "wrap_text": false,
          "max_lines": 1
        }
      },
      {
        "variable_name": "$_PAYLOAD_DESCRIPTION",
        "x": 26,
        "y": 112,
        "string_template": {
          "text_size": "small",
          "text_color_palette": "magenta",
          "max_chars": 32,
          "wrap_text": true,
          "max_lines": 2
        },
        "text_size": "small",
        "wrap_text": true,
        "max_chars": 84,
        "max_lines": 3
      }
    ]
  },
  "menu_items": [
    {
      "id": "Launch",
      "layers": [
        {
          "image_path": "assets/launch_payload_dialog/launch_button.png",
          "x": 26,
          "y": 172,
          "recolor_palette": "medium_gray"
        }
      ],
      "selected_layers": [
        {
          "image_path": "assets/launch_payload_dialog/launch_button.png",
          "x": 26,
          "y": 172
        }
      ],
      "target": "launch_payload",
      "variable": "$_INPUT",
      "animation": [
        {
          "image_path": "assets/launch_payload_dialog/animation/reaper-1.png",
          "x": 360,
          "y": 75
        },
        {
          "image_path": "assets/launch_payload_dialog/animation/reaper-2.png",
          "x": 360,
          "y": 75
        },
        {
          "image_path": "assets/launch_payload_dialog/animation/reaper-3.png",
          "x": 360,
          "y": 75
        },
        {
          "image_path": "assets/launch_payload_dialog/animation/reaper-4.png",
          "x": 360,
          "y": 75
        }
      ]
    },
    {
      "id": "Cancel",
      "layers": [
        {
          "image_path": "assets/launch_payload_dialog/cancel_button.png",
          "x": 122,
          "y": 172,
          "recolor_palette": "medium_gray"
        }
      ],
      "selected_layers": [
        {
          "image_path": "assets/launch_payload_dialog/cancel_button.png",
          "x": 122,
          "y": 172
        }
      ],
      "target": "back"
    }
  ]
}
