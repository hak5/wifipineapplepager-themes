{
  "screen_name": "pager_portal_payloads_dashboard",
  "status_bar": "default",
  "windowed_canvas": false,
  "cache_canvases": false,
  "background": {
    "layers": [
      { "image_path": "assets/pager_portal/pager_portal_dashboard_payloads.png", "x": 0, "y": 0 },
      { "text": "Payload Portal", "text_size": "large", "text_color_palette": "magenta", "x": 5 }
    ],
    "background_color": { "r": 0, "g": 0, "b": 0 }
  },
  "pages": [
    {
      "page_index": 0,
      "menu_items": [
        {
          "id": "Get Payloads",
          "layers": [
            { "text": "Get Payloads", "x": 160, "y": 60, "text_color_palette": "dark_magenta" }
          ],
          "selected_layers": [
            { "text": "Get Payloads", "x": 160, "y": 60, "text_color_palette": "magenta" },
            { "image_path": "assets/alerts_dashboard/sub.png","x": 125, "y": 65 }

          ],
          "x": 60,
          "y": 20,
          "target": "pager_portal_get_payloads_dashboard"
        },
        {
          "id": "Update Payloads",
          "layers": [
            { "text": "Update Payloads", "x": 160, "y": 87, "text_color_palette": "dark_magenta" }
          ],
          "selected_layers": [
            { "text": "Update Payloads", "x": 160, "y": 87, "text_color_palette": "magenta" },
            { "image_path": "assets/alerts_dashboard/sub.png","x": 125, "y": 92 }

          ],
          "x": 60,
          "y": 20,
          "target": "pager_portal_update_payloads_dashboard"
        },
        {
          "id": "Uninstall Payloads",
          "layers": [
            { "text": "Uninstall Payloads", "x": 160, "y": 114, "text_color_palette": "dark_magenta" }
          ],
          "selected_layers": [
            { "text": "Uninstall Payloads", "x": 160, "y": 114, "text_color_palette": "magenta" },
            { "image_path": "assets/alerts_dashboard/sub.png","x": 125, "y": 119 }

          ],
          "x": 60,
          "y": 20,
          "target": "pager_portal_installed_payloads_list",
          "variable": "$_INSTALLED_PAYLOADS_LIST"
        }
      ]
    }
  ]
}