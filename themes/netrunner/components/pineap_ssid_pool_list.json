{
  "template": {
    "screen_name": "pineap_ssid_pool_list",
    "windowed_canvas": true,
    "cache_canvases": false,
    "background": {
      "layers": [
        { "image_path": "assets/optiondialog/option_dialog_bg_full.png" },
        { "variable_name": "$_INPUT_NAME", "x": 50, "y": 25, "use_template": "string_title" },
        { "variable_name": "$_LIST_SIZE", "x": 425, "y": 45, "string_template":{ "text_size": "small", "text_color_palette": "medium_gray","center_text_within": { "draw_bounds": false, "start_x": 415, "end_x": 440, "start_y": 45, "end_y": 58 }}},
        { "variable_name": "$_LIST_PAGINATOR_LABEL_SHORT", "x": 415, "y": 32, "use_template": "list_pagination_label" }
      ]
    },
    "button_map": {
      "a": "select",
      "b": "back",
      "up": "previous",
      "down": "next",
      "left": "previous_page",
      "right": "next_page"
    },
    "pages": [
      {
        "menu_items": [
